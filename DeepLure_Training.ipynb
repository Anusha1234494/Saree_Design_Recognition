#17.1 Create the model

class SiameseNetwork(nn.Module):

    def __init__(self, embedding_dim=128):

        super().__init__()

        # Pretrained ResNet18
        backbone = models.resnet18(
            weights=models.ResNet18_Weights.DEFAULT
        )

        # Number of features produced by ResNet18
        num_features = backbone.fc.in_features

        # Remove the original ImageNet classifier
        backbone.fc = nn.Identity()

        self.backbone = backbone

        # Convert ResNet features into our saree embedding
        self.embedding = nn.Sequential(
            nn.Linear(num_features, 256),
            nn.ReLU(),
            nn.Dropout(0.2),
            nn.Linear(256, embedding_dim)
        )

    def forward_once(self, x):

        features = self.backbone(x)

        embedding = self.embedding(features)

        # Normalize embedding
        embedding = F.normalize(
            embedding,
            p=2,
            dim=1
        )

        return embedding

    def forward(self, image1, image2):

        embedding1 = self.forward_once(image1)
        embedding2 = self.forward_once(image2)

        return embedding1, embedding2


