#Step 31.1 — Create three transformations 

mild_color_transform = transforms.Compose([
    transforms.Resize((224, 224)),

    transforms.ColorJitter(
        brightness=0.15,
        contrast=0.15,
        saturation=0.35,
        hue=0.05
    ),

    transforms.ToTensor(),

    transforms.Normalize(
        mean=[0.485, 0.456, 0.406],
        std=[0.229, 0.224, 0.225]
    )
])


strong_color_transform = transforms.Compose([
    transforms.Resize((224, 224)),

    transforms.ColorJitter(
        brightness=0.30,
        contrast=0.30,
        saturation=0.90,
        hue=0.15
    ),

    transforms.ToTensor(),

    transforms.Normalize(
        mean=[0.485, 0.456, 0.406],
        std=[0.229, 0.224, 0.225]
    )
])


extreme_color_transform = transforms.Compose([
    transforms.Resize((224, 224)),

    transforms.ColorJitter(
        brightness=0.45,
        contrast=0.45,
        saturation=1.20,
        hue=0.25
    ),

    transforms.ToTensor(),

    transforms.Normalize(
        mean=[0.485, 0.456, 0.406],
        std=[0.229, 0.224, 0.225]
    )
])


#Step 31.2 — Create an evaluation function 

def evaluate_color_retrieval(transform):

    top1 = 0
    top5 = 0

    for query_path in test_df["path"]:

        original = Image.open(
            query_path
        ).convert("RGB")

        query_embedding = get_embedding(
            original,
            transform
        )

        similarities = cosine_similarity(
            query_embedding.reshape(1, -1),
            cross_gallery_embeddings
        )[0]

        ranked_indices = np.argsort(
            similarities
        )[::-1]

        ranked_paths = [
            cross_gallery_paths[i]
            for i in ranked_indices
        ]

        rank = ranked_paths.index(
            query_path
        ) + 1

        if rank == 1:
            top1 += 1

        if rank <= 5:
            top5 += 1

    total = len(test_df)

    return (
        top1 / total,
        top5 / total
    )


#Step 31.3 — Run all three 

mild_top1, mild_top5 = evaluate_color_retrieval(
    mild_color_transform
)

strong_top1, strong_top5 = evaluate_color_retrieval(
    strong_color_transform
)

extreme_top1, extreme_top5 = evaluate_color_retrieval(
    extreme_color_transform
)

