#Step 23.2 — Function to generate embeddings 

def get_embedding(image, transform):

    image = transform(image)
    image = image.unsqueeze(0).to(device)

    model.eval()

    with torch.no_grad():
        embedding = model.forward_once(image)

    return embedding.cpu().numpy()[0]



#Step 23.3 — Test SAME image with different colors 

from sklearn.metrics.pairwise import cosine_similarity

results = []

for path in test_df["path"]:

    original = Image.open(path).convert("RGB")

    # Original embedding
    emb_original = get_embedding(
        original,
        eval_transform
    )

    # Color-transformed embedding
    emb_color = get_embedding(
        original,
        cross_color_transform
    )

    similarity = cosine_similarity(
        emb_original.reshape(1, -1),
        emb_color.reshape(1, -1)
    )[0][0]

    results.append({
        "path": path,
        "similarity": similarity
    })

cross_color_df = pd.DataFrame(results)

