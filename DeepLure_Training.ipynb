y_true = verification_df["label"].values
y_score = verification_df["similarity"].values

fpr, tpr, thresholds = roc_curve(
    y_true,
    y_score
)

auc = roc_auc_score(
    y_true,
    y_score
)

# Youden's J statistic
j_scores = tpr - fpr

best_idx = np.argmax(j_scores)

best_threshold = thresholds[best_idx]

print("ROC-AUC:", auc)
print("Best threshold:", best_threshold)


#26 — Calculate verification metrics 

predictions = (
    y_score >= best_threshold
).astype(int)

accuracy = accuracy_score(
    y_true,
    predictions
)

precision = precision_score(
    y_true,
    predictions
)

recall = recall_score(
    y_true,
    predictions
)

f1 = f1_score(
    y_true,
    predictions
)

print("Verification Accuracy :", accuracy)
print("Precision              :", precision)
print("Recall                 :", recall)
print("F1 Score               :", f1)


#27 — Build the gallery 

def build_gallery(dataframe):
    
    gallery_embeddings = []
    gallery_paths = []

    model.eval()

    for path in dataframe["path"]:

        image = Image.open(path).convert("RGB")

        embedding = get_embedding(
            image,
            eval_transform
        )

        gallery_embeddings.append(embedding)
        gallery_paths.append(path)

    gallery_embeddings = np.vstack(
        gallery_embeddings
    )

    return gallery_embeddings, gallery_paths


gallery_embeddings, gallery_paths = build_gallery(
    train_df
)

print(
    "Gallery embeddings:",
    gallery_embeddings.shape
)

print(
    "Gallery images:",
    len(gallery_paths)
)


#STEP 28 — Query → Top-K Search 

def search_gallery(
    query_path,
    gallery_embeddings,
    gallery_paths,
    top_k=5
):

    # Load query image
    query_image = Image.open(
        query_path
    ).convert("RGB")

    # Get query embedding
    query_embedding = get_embedding(
        query_image,
        eval_transform
    )

    # Calculate cosine similarity
    similarities = cosine_similarity(
        query_embedding.reshape(1, -1),
        gallery_embeddings
    )[0]

    # Get highest similarity scores
    top_indices = np.argsort(
        similarities
    )[::-1][:top_k]

    results = []

    for idx in top_indices:

        results.append({
            "path": gallery_paths[idx],
            "similarity": float(
                similarities[idx]
            )
        })

    return results


#Step 28.1 — Test it 

